# Umami Cloud website ID (TASKS.md 1.9). Set in the Netlify build environment;
# the tracking script only loads when this is present.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# football-data.org free key for the UCL engine (local runs; in CI it is the
# FOOTBALL_DATA_TOKEN repository secret). Never commit the value.
FOOTBALL_DATA_TOKEN=
